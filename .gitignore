# Dependencies & builds
node_modules/
dist/
__pycache__/
*.pyc
backend/.venv/
.venv/

# Sample audio is NOT redistributed in the repository (licence + size).
# Reproduce with scripts/download_samples.py; the manifest stays tracked.
data/samples/*
!data/samples/manifest.json
!data/samples/README.md
# The Hugging Face Space copy has to serve the clips (a visitor installs
# nothing), but they still do not belong in this repository's history.
hf-space/samples/*
!hf-space/samples/manifest.json
data/_dbg/
data/*.txt
# evidence transcript referenced by MODEL_CARD/TEST_REPORT
!data/smoke_run.txt
# Command output logs are regenerated by every run (and PowerShell writes them
# as UTF-16, so Git sees them as binary churn). They are local evidence only;
# the curated transcripts that docs cite are the .md/.json files.
data/*.log

# Browser-verification scratch screenshots. Curated evidence shots stay tracked
# — see the exception below and the e2e_*/test_*/qoder_step* files.
data/retest*.png
!data/retest2_step4_results_indian_robin.png
data/qoder_check*.png
data/deploy_step*.png
data/check_*.png

# live-server runtime noise, not evidence
data/uvicorn.out
data/uvicorn.err

# Local env / OS noise
.env
.env.local
Thumbs.db
.DS_Store

# Vercel deploy artifacts (project link config + CLI temp scripts/logs)
.vercel/
.vercel-tmp/
