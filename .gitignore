hf-space/samples/*
!hf-space/samples/manifest.json
data/_dbg/
data/*.txt
# evidence transcript referenced by MODEL_CARD/TEST_REPORT
!data/smoke_run.txt
# live-server runtime noise, not evidence
data/uvicorn.out
data/uvicorn.err

